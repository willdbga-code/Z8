rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // Z8 E-Motion - Fort Knox Cyber Security & Row Level Security (RLS) Engine
    // Base de dados oficial: z8-emotion-brasil (Propriedade: Christian Hideyuki)
    // Zero Public Read, Zero Direct Unauthenticated Injection
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'christian.tkh@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userEmail) {
      return isAuthenticated() && request.auth.token.email.lower() == userEmail.lower();
    }

    // 1. BLINDAGEM TOTAL: Diretório de Usuários e Lojistas Z8 E-Motion
    match /catalog_users/{userEmail} {
      // PROIBIDO DUMP PÚBLICO: Apenas o próprio usuário autenticado ou o Master Admin podem ler
      allow read: if isOwner(userEmail) || isMasterAdmin();

      // PROIBIDA INJEÇÃO DIRETA DO NAVEGADOR:
      // Apenas o Master Admin pode alterar ou criar documentos diretamente no Firestore.
      // Novos cadastros de usuários devem ser validados pela API Serverless (/api/users)
      allow create: if isMasterAdmin();
      allow update: if isMasterAdmin() || (
        isOwner(userEmail) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isMasterAdmin();
    }

    // 2. BLINDAGEM TOTAL: CRM de Leads & Investidores
    match /leads/{leadId} {
      // Bloqueio de leitura pública: 100% exclusivo Master Admin
      allow read, update, delete: if isMasterAdmin();
      // Criação direta bloqueada: leads entram apenas via backend autenticado/sanitizado (/api/leads)
      allow create: if isMasterAdmin();
    }

    // 3. BLINDAGEM TOTAL: Ordens de Serviço (OS) & Garantias
    match /service_orders/{orderId} {
      allow read: if isMasterAdmin() || (
        isAuthenticated() && resource.data.userEmail.lower() == request.auth.token.email.lower()
      );
      allow create: if isMasterAdmin();
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }
  }
}

